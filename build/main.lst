 386:Core/Src/main.c **** void ssb_process_block(uint32_t *in, uint32_t *out, int n)
 387:Core/Src/main.c **** {
 388:Core/Src/main.c ****     static float I_buf[BLOCK_SIZE/2];
 389:Core/Src/main.c ****     static float Q_buf[BLOCK_SIZE/2];
 390:Core/Src/main.c **** 
 391:Core/Src/main.c ****     static float IQ_in[BLOCK_SIZE];     // interleaved I/Q
 392:Core/Src/main.c ****     static float NCO_buf[BLOCK_SIZE];   // interleaved cos/sin
 393:Core/Src/main.c ****     static float IQ_mix[BLOCK_SIZE];    // interleaved I/Q
 394:Core/Src/main.c **** 
 395:Core/Src/main.c ****     static float audio_buf[BLOCK_SIZE/2];
 396:Core/Src/main.c **** 
 397:Core/Src/main.c ****     // ---------------------------------------------------------
 398:Core/Src/main.c ****     // 1) ADC → normalisert I
 399:Core/Src/main.c ****     // ---------------------------------------------------------
 400:Core/Src/main.c ****     for (int i = 0; i < n; i++)
 401:Core/Src/main.c ****     {
 402:Core/Src/main.c ****         uint32_t raw = in[i] & 0x0FFF;
 403:Core/Src/main.c ****         I_buf[i] = ((float)raw - 2048.0f) / 2048.0f;
 404:Core/Src/main.c ****     }
 405:Core/Src/main.c **** 
 406:Core/Src/main.c ****     // ---------------------------------------------------------
 407:Core/Src/main.c ****     // 2) Hilbert → Q (for SSB og FM)
 408:Core/Src/main.c ****     // ---------------------------------------------------------
 409:Core/Src/main.c ****     arm_fir_f32(&hilbert, I_buf, Q_buf, n);
 410:Core/Src/main.c **** 
 411:Core/Src/main.c ****     // ---------------------------------------------------------
 412:Core/Src/main.c ****     // 3) Lag interleaved I/Q
 413:Core/Src/main.c ****     // ---------------------------------------------------------
 414:Core/Src/main.c ****     for (int i = 0; i < n; i++)
 415:Core/Src/main.c ****     {
 416:Core/Src/main.c ****         IQ_in[2*i + 0] = I_buf[i];
 417:Core/Src/main.c ****         IQ_in[2*i + 1] = Q_buf[i];
 418:Core/Src/main.c ****     }
 419:Core/Src/main.c **** 
 420:Core/Src/main.c ****     // ---------------------------------------------------------
 421:Core/Src/main.c ****     // 4) NCO → interleaved cos/sin
 422:Core/Src/main.c ****     // ---------------------------------------------------------
 423:Core/Src/main.c ****     for (int i = 0; i < n; i++)
 424:Core/Src/main.c ****     {
 425:Core/Src/main.c ****         float cs = cosf(nco.phase);
 426:Core/Src/main.c ****         float sn = sinf(nco.phase);
 427:Core/Src/main.c ****         nco_step(&nco);
 428:Core/Src/main.c **** 
 429:Core/Src/main.c ****         NCO_buf[2*i + 0] = cs;
 430:Core/Src/main.c ****         NCO_buf[2*i + 1] = sn;
ARM GAS  /tmp/ccxbErgA.s 			page 9


 431:Core/Src/main.c ****     }
 432:Core/Src/main.c **** 
 433:Core/Src/main.c ****     // ---------------------------------------------------------
 434:Core/Src/main.c ****     // 5) Kompleks mixing
 435:Core/Src/main.c ****     // ---------------------------------------------------------
 436:Core/Src/main.c ****     arm_cmplx_mult_cmplx_f32(IQ_in, NCO_buf, IQ_mix, n);
 437:Core/Src/main.c **** 
 438:Core/Src/main.c ****     // ---------------------------------------------------------
 439:Core/Src/main.c ****     // 6) Splitt ut I/Q etter mixing
 440:Core/Src/main.c ****     // ---------------------------------------------------------
 441:Core/Src/main.c ****     for (int i = 0; i < n; i++)
 442:Core/Src/main.c ****     {
 443:Core/Src/main.c ****         I_buf[i] = IQ_mix[2*i + 0];
 444:Core/Src/main.c ****         Q_buf[i] = IQ_mix[2*i + 1];
 445:Core/Src/main.c ****     }
 446:Core/Src/main.c **** 
 447:Core/Src/main.c ****     // ---------------------------------------------------------
 448:Core/Src/main.c ****     // 7) Pre-demod IF-filter
 449:Core/Src/main.c ****     // ---------------------------------------------------------
 450:Core/Src/main.c ****     arm_fir_f32(&pre_fm_I, I_buf, I_buf, n);
 451:Core/Src/main.c ****     arm_fir_f32(&pre_fm_Q, Q_buf, Q_buf, n);
 452:Core/Src/main.c **** 
 453:Core/Src/main.c ****     // ---------------------------------------------------------
 454:Core/Src/main.c ****     // 8) MODE-basert demod
 455:Core/Src/main.c ****     // ---------------------------------------------------------
 456:Core/Src/main.c ****     if(MODE == MODE_USB)
 457:Core/Src/main.c ****     {
 458:Core/Src/main.c ****         // USB = I + Q
 459:Core/Src/main.c ****         for (int i = 0; i < n; i++)
 460:Core/Src/main.c ****             audio_buf[i] = I_buf[i] + Q_buf[i];
 461:Core/Src/main.c ****     }
 462:Core/Src/main.c ****     else if (MODE == MODE_LSB)
 463:Core/Src/main.c ****     {
 464:Core/Src/main.c ****         // LSB = I - Q
 465:Core/Src/main.c ****         for (int i = 0; i < n; i++)
 466:Core/Src/main.c ****             audio_buf[i] = I_buf[i] - Q_buf[i];
 467:Core/Src/main.c ****     }
 468:Core/Src/main.c ****     else
 469:Core/Src/main.c ****     {
 470:Core/Src/main.c ****         for (int i = 0; i < n; i++)
 471:Core/Src/main.c ****             audio_buf[i] = 0.0f;
 472:Core/Src/main.c ****     }
 473:Core/Src/main.c **** 
 474:Core/Src/main.c ****     // ---------------------------------------------------------
 475:Core/Src/main.c ****     // 9) Audio gain før DAC
 476:Core/Src/main.c ****     // ---------------------------------------------------------
 477:Core/Src/main.c ****     for (int i = 0; i < n; i++)
 478:Core/Src/main.c ****         audio_buf[i] *= 1500.0f;
 479:Core/Src/main.c **** 
 480:Core/Src/main.c ****     // ---------------------------------------------------------
 481:Core/Src/main.c ****     // 10) DAC output
 482:Core/Src/main.c ****     // ---------------------------------------------------------
 483:Core/Src/main.c ****     for (int i = 0; i < n; i++)
 484:Core/Src/main.c ****     {
 485:Core/Src/main.c ****         float y = audio_buf[i] + 2048.0f;
 486:Core/Src/main.c **** 
 487:Core/Src/main.c ****         if (y < 0.0f)    y = 0.0f;
ARM GAS  /tmp/ccxbErgA.s 			page 10


 488:Core/Src/main.c ****         if (y > 4095.0f) y = 4095.0f;
 489:Core/Src/main.c **** 
 490:Core/Src/main.c ****         out[i] = (uint32_t)y;
 491:Core/Src/main.c ****     }
 492:Core/Src/main.c **** }
 493:Core/Src/main.c **** 
 494:Core/Src/main.c **** void nbfm_process_block(uint32_t *in, uint32_t *out, int n)
 495:Core/Src/main.c **** {
 496:Core/Src/main.c ****     static float I_if[BLOCK_SIZE];
 497:Core/Src/main.c ****     static float Q_if[BLOCK_SIZE];
 498:Core/Src/main.c **** 
 499:Core/Src/main.c ****     static float IQ_in[BLOCK_SIZE * 2];    // interleaved I/Q
 500:Core/Src/main.c ****     static float NCO_buf[BLOCK_SIZE * 2];  // interleaved cos/sin
 501:Core/Src/main.c ****     static float IQ_mix[BLOCK_SIZE * 2];   // interleaved I/Q etter mixing
 502:Core/Src/main.c **** 
 503:Core/Src/main.c ****     static float audio_fm[BLOCK_SIZE];     // FM-demod audio (float)
 504:Core/Src/main.c ****     static float audio_lpf_out[BLOCK_SIZE];
 505:Core/Src/main.c **** 
 506:Core/Src/main.c ****     // -----------------------------
 507:Core/Src/main.c ****     // 1) ADC → normalisert IF (I)
 508:Core/Src/main.c ****     // -----------------------------
 509:Core/Src/main.c ****     for (int i = 0; i < n; i++)
 510:Core/Src/main.c ****     {
 511:Core/Src/main.c ****         uint32_t raw = in[i] & 0x0FFF;
 512:Core/Src/main.c ****         I_if[i] = ((float)raw - 2048.0f) / 2048.0f;
 513:Core/Src/main.c ****         //Q_if[i] = 0.0f;   // ren IF, ingen Hilbert her
 514:Core/Src/main.c ****     }
 515:Core/Src/main.c **** 
 516:Core/Src/main.c **** 
 517:Core/Src/main.c ****     arm_fir_f32(&hilbert, I_if, Q_if, n);
 518:Core/Src/main.c **** 
 519:Core/Src/main.c ****     // -----------------------------
 520:Core/Src/main.c ****     // 2) Lag interleaved I/Q
 521:Core/Src/main.c ****     // -----------------------------
 522:Core/Src/main.c ****     for (int i = 0; i < n; i++)
 523:Core/Src/main.c ****     {
 524:Core/Src/main.c ****         IQ_in[2*i + 0] = I_if[i];
 525:Core/Src/main.c ****         IQ_in[2*i + 1] = Q_if[i];
 526:Core/Src/main.c ****     }
 527:Core/Src/main.c **** 
 528:Core/Src/main.c ****     // -----------------------------
 529:Core/Src/main.c ****     // 3) NCO → interleaved cos/sin
 530:Core/Src/main.c ****     // -----------------------------
 531:Core/Src/main.c ****     for (int i = 0; i < n; i++)
 532:Core/Src/main.c ****     {
 533:Core/Src/main.c ****         float cs = cosf(nco_if.phase);
 534:Core/Src/main.c ****         float sn = sinf(nco_if.phase);
 535:Core/Src/main.c ****         nco_step(&nco_if);
 536:Core/Src/main.c **** 
 537:Core/Src/main.c ****         NCO_buf[2*i + 0] = cs;
 538:Core/Src/main.c ****         NCO_buf[2*i + 1] = sn;
 539:Core/Src/main.c ****     }
 540:Core/Src/main.c **** 
 541:Core/Src/main.c ****     // -----------------------------
 542:Core/Src/main.c ****     // 4) Kompleks mixing (IF → baseband FM)
 543:Core/Src/main.c ****     // -----------------------------
 544:Core/Src/main.c ****     arm_cmplx_mult_cmplx_f32(IQ_in, NCO_buf, IQ_mix, n);
ARM GAS  /tmp/ccxbErgA.s 			page 11


 545:Core/Src/main.c **** 
 546:Core/Src/main.c ****     // -----------------------------
 547:Core/Src/main.c ****     // 5) Splitt ut I/Q etter mixing
 548:Core/Src/main.c ****     // -----------------------------
 549:Core/Src/main.c ****     for (int i = 0; i < n; i++)
 550:Core/Src/main.c ****     {
 551:Core/Src/main.c ****         I_if[i] = IQ_mix[2*i + 0];
 552:Core/Src/main.c ****         Q_if[i] = IQ_mix[2*i + 1];
 553:Core/Src/main.c ****     }
 554:Core/Src/main.c **** 
 555:Core/Src/main.c ****     // -----------------------------
 556:Core/Src/main.c ****     // 6) Pre-demod IF-filter (kompleks)
 557:Core/Src/main.c ****     // -----------------------------
 558:Core/Src/main.c ****     arm_fir_f32(&pre_fm_I, I_if, I_if, n);
 559:Core/Src/main.c ****     arm_fir_f32(&pre_fm_Q, Q_if, Q_if, n);
 560:Core/Src/main.c **** 
 561:Core/Src/main.c ****     // -----------------------------
 562:Core/Src/main.c ****     // 7) FM-demodulator (din nbfm_demod)
 563:Core/Src/main.c ****     // -----------------------------
 564:Core/Src/main.c ****     nbfm_demod(I_if, Q_if, audio_fm, n);
 565:Core/Src/main.c **** 
 566:Core/Src/main.c ****     // -----------------------------
 567:Core/Src/main.c ****     // 8) Audio LPF etter FM-demod
 568:Core/Src/main.c ****     // -----------------------------
 569:Core/Src/main.c ****     arm_fir_f32(&audio_lpf, audio_fm, audio_lpf_out, n);
 570:Core/Src/main.c **** 
 571:Core/Src/main.c ****     // -----------------------------
 572:Core/Src/main.c ****     // 9) Gain + DAC-skalering
 573:Core/Src/main.c ****     // -----------------------------
 574:Core/Src/main.c ****     for (int i = 0; i < n; i++)
 575:Core/Src/main.c ****     {
 576:Core/Src/main.c ****         float y = audio_lpf_out[i] * 1500.0f + 2048.0f;
 577:Core/Src/main.c **** 
 578:Core/Src/main.c ****         if (y < 0.0f)    y = 0.0f;
 579:Core/Src/main.c ****         if (y > 4095.0f) y = 4095.0f;
 580:Core/Src/main.c **** 
 581:Core/Src/main.c ****         out[i] = (uint32_t)y;
 582:Core/Src/main.c ****     }
 583:Core/Src/main.c **** }
 584:Core/Src/main.c **** 
 585:Core/Src/main.c **** void nbfm_tx_process_block(uint32_t *in, uint32_t *out, int n)
 586:Core/Src/main.c **** {
 587:Core/Src/main.c ****     static float audio_in[BLOCK_SIZE];
 588:Core/Src/main.c ****     static float audio_filtered[BLOCK_SIZE];
 589:Core/Src/main.c ****     static float phase = 0.0f;
 590:Core/Src/main.c **** 
 591:Core/Src/main.c ****     const float kf = 2.0f * M_PI * 5000.0f / 48000.0f;   // FM deviation
 592:Core/Src/main.c ****     const float w_if = 2.0f * M_PI * 12000.0f / 48000.0f; // 12 kHz IF
 593:Core/Src/main.c **** 
 594:Core/Src/main.c ****     // 1) ADC → normalisert audio
 595:Core/Src/main.c ****     for (int i = 0; i < n; i++) {
 596:Core/Src/main.c ****         uint32_t raw = in[i] & 0x0FFF;
 597:Core/Src/main.c ****         audio_in[i] = (((float)raw - 2048.0f) / 2048.0f) * 10.0f; // scale to ±5
 598:Core/Src/main.c ****     }
 599:Core/Src/main.c **** 
 600:Core/Src/main.c ****     // 2) Audio LPF
 601:Core/Src/main.c ****     arm_fir_f32(&audio_lpf, audio_in, audio_filtered, n);
ARM GAS  /tmp/ccxbErgA.s 			page 12


 602:Core/Src/main.c **** 
 603:Core/Src/main.c ****     // 3) FM direkte på NCO
 604:Core/Src/main.c ****     for (int i = 0; i < n; i++) {
 605:Core/Src/main.c **** 
 606:Core/Src/main.c ****         // FM-modulasjon: fase += kf * audio
 607:Core/Src/main.c ****         phase += w_if + kf * audio_filtered[i];
 608:Core/Src/main.c **** 
 609:Core/Src/main.c ****         if (phase > M_PI) phase -= TWO_PI;
 610:Core/Src/main.c ****         if (phase < -M_PI) phase += TWO_PI;
 611:Core/Src/main.c **** 
 612:Core/Src/main.c ****         float s = cosf(phase);   // real FM på 12 kHz IF
 613:Core/Src/main.c **** 
 614:Core/Src/main.c ****         out[i] = (uint32_t)((s * 2048.0f) + 2048.0f);
 615:Core/Src/main.c ****     }
 616:Core/Src/main.c **** }
 617:Core/Src/main.c **** 
 618:Core/Src/main.c **** 
 619:Core/Src/main.c **** void process_block(uint32_t *in, uint32_t *out, int n)
 620:Core/Src/main.c **** {
 621:Core/Src/main.c ****     if (MODE == MODE_NBFM)
 622:Core/Src/main.c ****     {
 623:Core/Src/main.c ****         nbfm_process_block(in, out, n);
 624:Core/Src/main.c ****     }
 625:Core/Src/main.c ****     else
 626:Core/Src/main.c ****     {
 627:Core/Src/main.c ****         ssb_process_block(in, out, n);  // din eksisterende SSB-pipe
 628:Core/Src/main.c ****     }
 629:Core/Src/main.c **** }
 630:Core/Src/main.c **** 
