# Build output
firmware/build/

# codec2 is a submodule; its own build tree is not ours to track
firmware/codec2/build/

# GRC generates these from the .grc sources
firmware/GNURadio/**/*.py
firmware/GNURadio/**/__pycache__/

# Editor/tool config with a machine-local absolute path
.vscode/
.claude/

# LibreOffice lock file for open documents
.~lock.*#

# Full upstream Hamlib checkout (CAT backend dev/test) - not ours to track
Hamlib/

# Local install of grig (GUI CAT test client), built from source against
# the Hamlib checkout above - not ours to track either
grig-local/
