# debug build?
DEBUG = 1
# optimization

# -Og (CubeMX's debug-build default) was fine for bring-up, but this is a
# real-time DSP signal chain - the FreeDV/codec2 files already override to
# -O3 below, but the glue code that runs before them every sample
# (Hilbert transform, NCO mixing, decimation/interpolation in rx_chain.c/
# freedv_chain.c) was still stuck at -Og, and FreeDV 700D's process_block()
# was measured at >200% of its real-time budget on real hardware as a
# result (never syncing). -O2 is a substantial, well-tested step up
# without -O3's more aggressive size/inlining tradeoffs project-wide.
OPT = -O2


