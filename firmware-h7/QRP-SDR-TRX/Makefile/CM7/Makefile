# __EMBEDDED__ drops the parts of struct MODEM_STATS that only exist to
# feed a GUI (freedv_open() would otherwise ask for more than it can get
# on a bare-metal heap) and routes codec2's allocations through
# codec2_malloc/calloc/free (see freedv_chain.c). Mirrors firmware/Makefile
# and codec2/stm32/CMakeLists.txt.
CFLAGS += -D__EMBEDDED__

# codec2-only: -fsingle-precision-constant keeps codec2's many unsuffixed
# float literals (which C promotes to double by default) in single
# precision - still worth it on H755's dual-precision FPU even though the
# original single-precision-only-FPU rationale (avoiding software-emulated
# double math on F746) doesn't apply here; codec2 itself is float-typed
# throughout, and -O3 overrides the project's debug -Og for this one
# real-time-critical library, same reasoning as firmware/Makefile.
CODEC2_OBJECTS = $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES_CODEC2:.c=.o)))
$(CODEC2_OBJECTS): CFLAGS += -fsingle-precision-constant -O3 -D__FPU_PRESENT=1


